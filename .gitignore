# Secrets / credentials
.env
*.env
.secrets/
*secret*
*token*
credentials*
*.pem
id_ed25519*

# Per-robot ArduinoOTA identity and authentication-equivalent password hash.
firmware/sesame-s3-pca9685/ota-local-config.h

# Agent transients (screenshots, observational memory, parked issues)
.pi/
.memory/
.parked/

# Unmodified upstream headers, fetched next to the sketch so Arduino can find
# them. Deliberately not vendored -- see firmware/sesame-s3-pca9685/README.md.
# Re-fetch with the curl commands in that README.
firmware/sesame-s3-pca9685/face-bitmaps.h
firmware/sesame-s3-pca9685/movement-sequences.h
firmware/sesame-s3-pca9685/captive-portal.h

# Isolated agent worktrees
.worktrees/

# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp

# Build / toolchain output
build/
.pio/
.pioenvs/
node_modules/
__pycache__/
*.pyc

# KiCad transient files (if a PCB follows later)
*-backups/
*.kicad_prl
fp-info-cache
*.bak

# Large upstream binaries must not be vendored here - reference upstream instead
*.f3z
*.step
*.stl
# Unmodified upstream sketch, kept locally as the diff baseline. Not vendored,
# for the same reason as the headers above; re-fetch with the curl command in
# firmware/sesame-s3-pca9685/README.md.
firmware/original sesame-firmware-main.ino
